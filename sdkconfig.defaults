# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 默认模板只保留 NVS、PHY data 和占用剩余空间的 factory app；用户可按需修改。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# 小诺简录:中文 UI 与网络动态中文内容,启用 LVGL 内置思源黑体 16 CJK 子集。
# 覆盖率边界见 docs/development/engineering/lvgl-chinese-fonts.md。
CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_16_CJK=y
# LVGL 内置 malloc 池大小(KB)。它是独立静态区、不与系统堆共享,配大了会白白占用 RAM。
# 本 demo UI 简单,24KB 足够;若自建复杂界面出现绘制卡死/看门狗,调大此值。
CONFIG_LV_MEM_SIZE_KILOBYTES=10

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000

# --- Bluetooth LE / NimBLE ---
# ESP32-C3 仅支持 BLE；示例只启用单连接 peripheral 所需的最小 host 配置。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# 小诺简录:首配走 BLUFI(EspBlufi App 下发 Wi-Fi 凭据)。
CONFIG_BT_NIMBLE_BLUFI_ENABLE=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_HOST_BASED_PRIVACY=n
CONFIG_BT_NIMBLE_NVS_PERSIST=n
# BLUFI 官方安全协商使用 DHM + AES + MD5。
CONFIG_MBEDTLS_HARDWARE_MPI=n
CONFIG_MBEDTLS_DHM_C=y

# --- 内存预算(无 PSRAM):配网期 Wi-Fi + NimBLE 必须共存 ---
# lwIP TCP 缓冲减半(省 ~6KB;局域网小包/流式上传足够)。
CONFIG_LWIP_TCP_WND_DEFAULT=2920
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2920
# NimBLE host 内存走内部静态池,避免配网期堆峰值(控制器仍需约 30KB 堆)。
# NimBLE host 内存按需从堆分配(配网结束 deinit 后归还)

# --- 任务看门狗:应用任务全部注册 TWDT,卡死自愈重启 ---
# 语音上传最长 30s(ASR+LLM),超时放宽到 40s。
CONFIG_ESP_TASK_WDT_TIMEOUT_S=40
# TWDT 超时触发 panic 复位(自愈),不只是打印警告。
CONFIG_ESP_TASK_WDT_PANIC=y
# lwip pbuf 池 16→10(TCP 窗口已减半,10 个在飞足够)。
CONFIG_LWIP_PBUF_POOL_SIZE=10
# Wi-Fi 静态接收缓冲 10→8,动态缓冲兜底。
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8

# 「关于」页:本地 lv_qrcode 生成作者主页二维码。
CONFIG_LV_USE_QRCODE=y
# raw565 图片经 lv_fs 走 POSIX 文件系统(P: 盘符,见 jianlu_ui raw565 解码器)
CONFIG_LV_USE_FS_POSIX=y
CONFIG_LV_FS_POSIX_LETTER=80
CONFIG_LV_FS_POSIX_PATH=""
